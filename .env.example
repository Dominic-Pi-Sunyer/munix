# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Meta Model API (https://dev.meta.ai/docs/), OpenAI-compatible.
MODEL_API_KEY=
# Every judged model is a Meta model: planner, reviewer, Readers and the demo agent.
MUNIX_SUPERVISOR_MODEL=muse-spark-1.3
MUNIX_WORKER_MODEL=muse-spark-1.3

# Web Speed OSS (the author's own open-source project, used as a dependency), MCP over stdio.
WEBSPEED_OSS_DIR=../web-speed-oss
# Opt-in so Web Speed OSS may read the demo site; it blocks loopback by default (SSRF).
WEBSPEED_ALLOW_HOSTS=pixelmart.test:8080
# The demo site, reached by name (the Gate refuses IP-literal URLs): add `127.0.0.1 pixelmart.test` to /etc/hosts.
MUNIX_DEMO_URL=http://pixelmart.test:8080

# email.send goes to a local Mailpit sink, never a real mailbox.
MUNIX_SMTP=127.0.0.1:1025
